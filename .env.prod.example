# Copy to .env.prod on the server (chmod 600, never commit it) and fill in.
# Staging: copy to .env.staging and change URLs, ports and passwords.

# Public URLs (no trailing slash)
APP_URL=https://app.boxos-app.de
API_URL=https://api.boxos-app.de

# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Local ports the host reverse proxy forwards to (staging: 8081 / 8091)
BACKEND_PORT=8080
WEB_PORT=8090

# Invite-only: sign-up off, no public demo accounts, sign-up hidden in the web app.
SIGNUP_ENABLED=0
SEED_DEMO_USERS=0
INVITE_ONLY=true

# Stripe (leave empty to keep payments switched off)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
